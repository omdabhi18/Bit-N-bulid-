# KrishiNetra AI Environment Configuration
APP_NAME="KrishiNetra AI"
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY="krishinetra-super-secret-key-change-in-production-2026!"

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./krishinetra.db
SYNC_DATABASE_URL=sqlite:///./krishinetra.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/krishinetra_db
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krishinetra_db

# Redis Caching
REDIS_URL=redis://localhost:6379/0

# Weather API (Open-Meteo is zero-config / OpenWeatherMap option)
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=

# LLM API (gemini / openai / mock)
LLM_PROVIDER=mock
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Indian Mandi / APMC Prices (agmarknet / mock)
MARKET_PROVIDER=agmarknet
MARKET_API_KEY=

# Storage Provider (local / cloudinary / s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-south-1

# MQTT & IoT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
USE_MOCK_IOT=true

# Voice AI (STT & TTS)
VOICE_STT_PROVIDER=webspeech
VOICE_STT_API_KEY=
VOICE_TTS_PROVIDER=browser
VOICE_TTS_API_KEY=
